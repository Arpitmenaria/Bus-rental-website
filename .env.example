# ─────────────────────────────────────────────────────────────────────────────
# ShivShakti Tourist — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Production URL — used for canonical links and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://shivshaktitourist.com

# ── Contact form (Phase 2) ────────────────────────────────────────────────────
# Web3Forms — get your free access key at https://web3forms.com
# All form submissions will be forwarded to your email address configured there.
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ── Analytics (Phase 5) ──────────────────────────────────────────────────────
# Vercel Analytics — enabled automatically on Vercel; no key needed.
# For GA4, add your Measurement ID here:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
